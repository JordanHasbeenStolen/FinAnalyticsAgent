# Copy this file to .env and fill in real values -- .env is git-ignored.
#
# LLM_BASE_URL/LLM_API_KEY work for anything speaking the OpenAI Chat
# Completions wire format: local servers (mlx_lm.server, Ollama, vLLM),
# OpenAI itself, or Azure OpenAI. Only uncomment ONE block below.
#
# Anthropic is NOT a drop-in base_url swap -- it needs a different
# LangChain class (ChatAnthropic, package langchain-anthropic), not
# ChatOpenAI. Not wired into finanalyticsagent/graph.py yet.

# --- Local (default for this project: mlx_lm.server on a Mac on the LAN) ---
LLM_BASE_URL=http://10.195.19.15:8000/v1
LLM_MODEL=Qwen/Qwen3-8B-MLX-4bit
LLM_API_KEY=dummy

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# --- Azure OpenAI (v1 API, works directly with ChatOpenAI) ---
# LLM_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1
# LLM_MODEL=<your-deployment-name>
# LLM_API_KEY=<azure-api-key>

# --- Anthropic (needs langchain_anthropic.ChatAnthropic instead, see note above) ---
# ANTHROPIC_API_KEY=sk-ant-...

# Embeddings -- same idea, kept separate since a chat-model switch (e.g. to
# Anthropic, which has no embeddings of its own) doesn't imply an
# embeddings-model switch.
EMBEDDINGS_BASE_URL=http://10.195.19.15:8090/v1
EMBEDDINGS_MODEL=mlx-community/Qwen3-Embedding-0.6B-mxfp8
EMBEDDINGS_API_KEY=dummy
