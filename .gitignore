# Python
__pycache__/
*.pyc
*.pyo

# Virtual environments
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Environment variables
.env
.env.*
!.env.example

# Data (never commit real data)
data/*
!data/.gitkeep

# Generated charts (may visualize real uploaded data)
outputs/*
!outputs/.gitkeep

# Persisted Chroma vector index (regenerable from bazaar_books/*, may hold real uploaded documents)
chroma_db/*
!chroma_db/.gitkeep

# IDE
.vscode/
.idea/
.DS_Store
Thumbs.db

# Windows zone-identifier artifacts (WSL file transfers)
*:Zone.Identifier

# Personal Claude Code context (not for public repo)
CLAUDE.local.md
